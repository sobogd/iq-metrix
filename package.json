{
  "name": "iq-metrix",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone cookieless analytics backend + admin for IQ Rest products",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && prisma generate",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.2.1",
    "isbot": "^5.2.2",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
