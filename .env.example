# Copy to .env for local dev. Real values (prod) live in GitHub Actions
# secrets and are written to the server's .env by .github/workflows/deploy.yml
# — never commit a real .env.

# Local Postgres example; prod uses the shared VPS's Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iq_metrix

# Intended prod port (this workspace's sibling services already use
# 8200-8204; iq-metrix is next). Intended prod domain:
# iq-metrix.iq-rest.com (DNS/nginx/certbot for it are set up separately,
# not part of this app).
PORT=8205

# Shared secret the relay (built in a later task, lives inside iq-rest /
# translator) must send as the `X-Ingest-Key` header on every POST /ingest
# call. This is the ONLY protection on that route until nginx exists in
# front of this service — see the comment at the top of src/routes/ingest.ts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SHARED_SECRET=

# Single admin account. There is no signup / user table — one operator.
ADMIN_USER=admin
# scrypt hash, format "<salt-hex>:<derived-hex>". Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password-here'
# Never put a plaintext password in this file or in the hash's place.
ADMIN_PASSWORD_HASH=

# HMAC key for the mtx_sess admin session cookie (src/lib/session-cookie.ts)
# and, reused with domain separation, the /ingest visit-continuation token
# (src/lib/visit-token.ts uses INGEST_SHARED_SECRET for that instead — see
# its file comment for why). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Not read by the server — only by scripts/import-history.ts (one-time
# backfill, not part of the normal app). Optional: the script already
# defaults to each product's local dev DB (see the script's own comment);
# set this to override, e.g. for a future prod cutover run.
# SOURCE_DATABASE_URL=
